<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5_robotiq">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import ur5_robotiq urdf file -->
    <xacro:include filename="$(find my_pick_and_place)/urdf/ur5_with_gripper.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="ur5_robotiq.ros2_control.xacro" />


    <xacro:ur5_robotiq_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
